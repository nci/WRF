#!/bin/bash
#PBS -l walltime=3:30:00
#PBS -l mem=52GB
#PBS -l ncpus=13
#PBS -j oe
#PBS -q normalsr
#PBS -l wd
#PBS -W umask=0022
#PBS -l software=intel-compiler
