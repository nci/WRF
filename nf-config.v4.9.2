#! /bin/sh
#
# This forms the basis for the nf-config utility, which tells you
# various things about the netCDF fortran installation.

prefix=/apps/netcdf/4.9.2
exec_prefix=${prefix}
libdir=/apps/netcdf/4.9.2/lib
includedir=/apps/netcdf/4.9.2/include
fmoddir=${includedir}
### NCI: Try to guess which Fortran libraries the user is expecting
get_fortran() {
    ### If any of the following are set to ifort, the user probably wants
    ### Intel libraries
    if [ 'x'$OMPI_FC == 'xifort' ] || [ 'x'$I_MPI_FC == 'xifort' ] || [ 'x'$FC == 'xifort' ] || [ 'x'$HDF5_FC == 'xifort' ]; then
	echo Intel
    elif [ 'x'$OMPI_FC == 'xifx' ] || [ 'x'$I_MPI_FC == 'xifx' ] || [ 'x'$FC == 'xifx' ] || [ 'x'$HDF5_FC == 'xifx' ]; then
	echo Intel
    elif [ 'x'$FC == 'xnvfortran' ]; then
	echo nvidia
    else
	echo GNU
    fi
    
}
cc="gcc"
#fc="nvfortran"
#cflags="-I${includedir} " 
#fflags="-I${includedir} -I${fmoddir}"
if [[ $( get_fortran ) == "GNU" ]]; then
    fc="gfortran"
elif [[ $(get_fortran ) == "Intel" ]]; then
    fc="ifort"
elif [[ $(get_fortran ) == "nvidia" ]]; then
    fc="nvfortrain"
else
    fc="gfortran"
fi
cflags="-I${includedir}/ " 
fflags="-I${includedir}/$( get_fortran ) -I${fmoddir}"

has_dap="yes"
has_nc2="yes"
has_nc4="yes"
has_f90=""
has_f03="yes"
#flibs="-L${libdir} -lnetcdff  -lnetcdf -lnetcdf -ldl -lm "
flibs="-L${libdir}/$( get_fortran ) -lnetcdff -ldl -lm"
version="netCDF-Fortran 4.6.1"

usage()
{
    cat <<EOF
Usage: nf-config [OPTION]

Available values for OPTION include:

  --help        display this help message and exit
  --all         display all options
  --cc          C compiler
  --fc          Fortran compiler
  --cflags      pre-processor and compiler flags
  --fflags      flags needed to compile a Fortran program
  --has-dap     whether OPeNDAP is enabled in this build
  --has-nc2     whether NetCDF-2 API is enabled
  --has-nc4     whether NetCDF-4/HDF-5 is enabled in this build
  --has-f90     whether Fortran 90 API is enabled in this build
  --has-f03     whether Fortran 2003 API is enabled in this build
  --flibs       libraries needed to link a Fortran program
  --prefix      Install prefix
  --includedir  Include directory
  --version     Library version

EOF

    exit $1
}

all()
{
        echo
        echo "This $version has been built with the following features: "
        echo
        echo "  --cc        -> $cc"
        echo "  --cflags    -> $cflags"
        echo
        echo "  --fc        -> $fc"
        echo "  --fflags    -> $fflags"
        echo "  --flibs     -> $flibs"
        echo "  --has-f90   -> $has_f90"
        echo "  --has-f03   -> $has_f03"
        echo
        echo "  --has-nc2   -> $has_nc2"
        echo "  --has-nc4   -> $has_nc4"
	echo
        echo "  --prefix    -> $prefix"
        echo "  --includedir-> $includedir"
        echo "  --version   -> $version"
        echo
}

if test $# -eq 0; then
    usage 1
fi

while test $# -gt 0; do
    case "$1" in
    # this deals with options in the style
    # --option=value and extracts the value part
    # [not currently used]
    -*=*) value=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
    *) value= ;;
    esac

    case "$1" in

    --help)
	usage 0
	;;

    --all)
	all
	;;

    --cc)
	echo $cc
	;;

    --fc)
	echo $fc
	;;

    --cflags)
	echo $cflags
	;;

    --fflags)
	echo $fflags
	;;

    --has-dap)
       	echo $has_dap
       	;;

    --has-nc2)
       	echo $has_nc2
       	;;

    --has-nc4)
       	echo $has_nc4
       	;;

    --has-f90)
       	echo $has_f90
       	;;

    --has-f03)
       	echo $has_f03
       	;;

    --flibs)
       	echo $flibs
       	;;

    --prefix)
       	echo "${prefix}"
       	;;

    --includedir)
       	echo "${includedir}"
       	;;

    --version)
	echo $version
	;;

    *)
        echo "unknown option: $1"
	usage
	exit 1
	;;
    esac
    shift
done

exit 0
